VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN recovery_rows ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 3000 3000 ) ;
ROW ROW_0 pgcore 0 0 N DO 30 BY 1 STEP 100 0 ;
ROW ROW_1 pgcore 0 1000 FS DO 30 BY 1 STEP 100 0 ;
ROW ROW_2 pgcore 0 2000 N DO 30 BY 1 STEP 100 0 ;
COMPONENTS 24 ;
    - i0 PGINV + PLACED ( 1000 1000 ) FS ;
    - i1 PGINV + PLACED ( 1000 1000 ) FS ;
    - i2 PGINV + PLACED ( 1000 1000 ) FS ;
    - i3 PGINV + PLACED ( 1000 1000 ) FS ;
    - i4 PGINV + PLACED ( 1000 1000 ) FS ;
    - i5 PGINV + PLACED ( 1000 1000 ) FS ;
    - i6 PGINV + PLACED ( 1000 1000 ) FS ;
    - i7 PGINV + PLACED ( 1000 1000 ) FS ;
    - i8 PGINV + PLACED ( 1000 1000 ) FS ;
    - i9 PGINV + PLACED ( 1000 1000 ) FS ;
    - i10 PGINV + PLACED ( 1000 1000 ) FS ;
    - i11 PGINV + PLACED ( 1000 1000 ) FS ;
    - i12 PGINV + PLACED ( 1000 1000 ) FS ;
    - i13 PGINV + PLACED ( 1000 1000 ) FS ;
    - i14 PGINV + PLACED ( 1000 1000 ) FS ;
    - i15 PGINV + PLACED ( 1000 1000 ) FS ;
    - i16 PGINV + PLACED ( 1000 1000 ) FS ;
    - i17 PGINV + PLACED ( 1000 1000 ) FS ;
    - i18 PGINV + PLACED ( 1000 1000 ) FS ;
    - i19 PGINV + PLACED ( 1000 1000 ) FS ;
    - i20 PGINV + PLACED ( 1000 1000 ) FS ;
    - i21 PGINV + PLACED ( 1000 1000 ) FS ;
    - i22 PGINV + PLACED ( 1000 1000 ) FS ;
    - i23 PGINV + PLACED ( 1000 1000 ) FS ;
END COMPONENTS
END DESIGN
