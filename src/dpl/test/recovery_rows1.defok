VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN recovery_rows ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 3000 3000 ) ;
ROW ROW_0 pgcore 0 0 N DO 30 BY 1 STEP 100 0 ;
ROW ROW_1 pgcore 0 1000 FS DO 30 BY 1 STEP 100 0 ;
ROW ROW_2 pgcore 0 2000 N DO 30 BY 1 STEP 100 0 ;
COMPONENTS 24 ;
    - i0 PGINV + PLACED ( 1900 0 ) N ;
    - i1 PGINV + PLACED ( 2500 2000 ) N ;
    - i10 PGINV + PLACED ( 1600 1000 ) FS ;
    - i11 PGINV + PLACED ( 400 2000 ) N ;
    - i12 PGINV + PLACED ( 1600 2000 ) N ;
    - i13 PGINV + PLACED ( 1000 2000 ) N ;
    - i14 PGINV + PLACED ( 700 2000 ) N ;
    - i15 PGINV + PLACED ( 2500 0 ) N ;
    - i16 PGINV + PLACED ( 700 0 ) N ;
    - i17 PGINV + PLACED ( 2200 1000 ) FS ;
    - i18 PGINV + PLACED ( 1300 2000 ) N ;
    - i19 PGINV + PLACED ( 400 1000 ) FS ;
    - i2 PGINV + PLACED ( 1300 0 ) N ;
    - i20 PGINV + PLACED ( 700 1000 ) FS ;
    - i21 PGINV + PLACED ( 1000 1000 ) FS ;
    - i22 PGINV + PLACED ( 1300 1000 ) FS ;
    - i23 PGINV + PLACED ( 1000 0 ) N ;
    - i3 PGINV + PLACED ( 2500 1000 ) FS ;
    - i4 PGINV + PLACED ( 2200 0 ) N ;
    - i5 PGINV + PLACED ( 1900 1000 ) FS ;
    - i6 PGINV + PLACED ( 2200 2000 ) N ;
    - i7 PGINV + PLACED ( 400 0 ) N ;
    - i8 PGINV + PLACED ( 1600 0 ) N ;
    - i9 PGINV + PLACED ( 1900 2000 ) N ;
END COMPONENTS
NETS 0 ;
END NETS
END DESIGN
