VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN precise_pg_place ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 10000 4000 ) ;
ROW ROW_0 pgcore 0 0 N DO 100 BY 1 STEP 100 0 ;
ROW ROW_1 pgcore 0 1000 FS DO 100 BY 1 STEP 100 0 ;
ROW ROW_2 pgcore 0 2000 N DO 100 BY 1 STEP 100 0 ;
ROW ROW_3 pgcore 0 3000 FS DO 100 BY 1 STEP 100 0 ;
COMPONENTS 15 ;
    - c0 PGCOMB + PLACED ( 900 0 ) N ;
    - c1 PGCOMB + PLACED ( 3200 1000 ) FS ;
    - c2 PGCOMB + PLACED ( 6000 2000 ) N ;
    - i0 PGINV + PLACED ( 1000 0 ) N ;
    - i1 PGINV + PLACED ( 1100 0 ) N ;
    - i2 PGINV + PLACED ( 2950 1000 ) FS ;
    - i3 PGINV + PLACED ( 3050 1000 ) FS ;
    - i4 PGINV + PLACED ( 4000 3000 ) FS ;
    - i5 PGINV + PLACED ( 5040 2000 ) N ;
    - i6 PGINV + PLACED ( 7000 0 ) N ;
    - i7 PGINV + PLACED ( 7100 0 ) N ;
    - i8 PGINV + PLACED ( 8050 3000 ) FS ;
    - i9 PGINV + PLACED ( 8800 1000 ) FS ;
    - i10 PGINV + PLACED ( 9000 2000 ) N ;
    - i11 PGINV + PLACED ( 2000 3000 ) FS ;
END COMPONENTS
SPECIALNETS 1 ;
    - VDD ( * VDD ) + USE POWER
      + ROUTED M2 20 + SHAPE STRIPE ( 1070 0 ) ( 1070 4000 )
      NEW M2 20 + SHAPE STRIPE ( 2070 0 ) ( 2070 4000 )
      NEW M2 20 + SHAPE STRIPE ( 3070 0 ) ( 3070 4000 )
      NEW M2 20 + SHAPE STRIPE ( 4070 0 ) ( 4070 4000 )
      NEW M2 20 + SHAPE STRIPE ( 5070 0 ) ( 5070 4000 )
      NEW M2 20 + SHAPE STRIPE ( 6070 0 ) ( 6070 4000 )
      NEW M2 20 + SHAPE STRIPE ( 7070 0 ) ( 7070 4000 )
      NEW M2 20 + SHAPE STRIPE ( 8070 0 ) ( 8070 4000 )
      NEW M2 20 + SHAPE STRIPE ( 9070 0 ) ( 9070 4000 ) ;
END SPECIALNETS
NETS 14 ;
    - n0 ( c0 Y ) ( c1 A ) ;
    - n1 ( c1 Y ) ( c2 A ) ;
    - n2 ( c2 Y ) ( i0 A ) ;
    - n3 ( i0 Y ) ( i1 A ) ;
    - n4 ( i1 Y ) ( i2 A ) ;
    - n5 ( i2 Y ) ( i3 A ) ;
    - n6 ( i3 Y ) ( i4 A ) ;
    - n7 ( i4 Y ) ( i5 A ) ;
    - n8 ( i5 Y ) ( i6 A ) ;
    - n9 ( i6 Y ) ( i7 A ) ;
    - n10 ( i7 Y ) ( i8 A ) ;
    - n11 ( i8 Y ) ( i9 A ) ;
    - n12 ( i9 Y ) ( i10 A ) ;
    - n13 ( i10 Y ) ( i11 A ) ;
END NETS
END DESIGN
